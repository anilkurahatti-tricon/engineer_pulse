# Copy this file to .env and fill in real values. Never commit the real .env file.

APP_NAME="Engineer Pulse API"
APP_VERSION=0.1.0
ENVIRONMENT=development

# Comma is not supported here yet: use "*" or a single origin, e.g. http://localhost:5173
CORS_ALLOW_ORIGINS=*

# AI provider selection: openai | azure_openai | none
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (used when AI_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
