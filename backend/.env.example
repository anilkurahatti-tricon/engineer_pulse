# Copy this file to .env and fill in real values. Never commit the real .env file.

APP_NAME="Engineer Pulse API"
APP_VERSION=0.1.0
ENVIRONMENT=development

# Comma is not supported here yet: use "*" or a single origin, e.g. http://localhost:5173
CORS_ALLOW_ORIGINS=*

# =============================================================================
# DATABASE CONNECTION
#
# OPTION 1 (Recommended for teams — Centralized Cloud DB):
#   Set DATABASE_URL to the shared Supabase/Neon/AWS connection string.
#   Everyone on the squad uses the same string — share it via squad secrets.
#   DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#
# OPTION 2 (Local Docker):
#   Leave DATABASE_URL blank and use the POSTGRES_* vars below.
#   Start local DB with: docker compose up -d
# =============================================================================
DATABASE_URL=

# Local Docker fallback (only used if DATABASE_URL is empty above)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=engineer_pulse

# =============================================================================
# AI PROVIDER
# =============================================================================

# AI provider selection: openai | azure_openai | none
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (used when AI_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
